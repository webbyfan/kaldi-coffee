PORT=5000

# MongoDB (Local or Atlas)
MONGO_URI=mongodb://localhost:27017/kaldicoffee
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kaldicoffee?retryWrites=true&w=majority

JWT_SECRET=kaldi_specialty_secret_key_2026

# ========================================================
# 1. Real Email Delivery (Gmail SMTP)
# ========================================================
# Use your Gmail address and a 16-character Google "App Password"
# (Get it at https://myaccount.google.com/apppasswords)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Store Business Email (Where customer orders and inquiries are routed)
# Change this when the website is transferred/sold to a new owner:
STORE_EMAIL=orders@kaldicoffee.com

# ========================================================
# 2. Real SMS Delivery (Ethiopia or International)
# ========================================================
# Option A: AfroMessage (Ethiopian Local SMS Gateway: https://afromessage.com)
AFROMESSAGE_TOKEN=your_afromessage_api_token
AFROMESSAGE_SENDER_ID=KaldiCoffee

# ========================================================
# 3. Real Ethiopian Payment Settings (Chapa, Telebirr, CBE)
# ========================================================
# Chapa Gateway Secret Key (https://chapa.co)
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key

# Store Direct Telebirr Transfer Account
TELEBIRR_RECEIVER_PHONE=+251911234567
TELEBIRR_RECEIVER_NAME=Kaldi Specialty Coffee

# Store Direct CBE Birr Account
CBE_ACCOUNT_NUMBER=1000123456789
CBE_ACCOUNT_NAME=Kaldi & Co Specialty Coffee

# Option B: Twilio (International)
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
